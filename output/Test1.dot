digraph G {
   edge [fontname="Helvetica",fontsize=10,labelfontname="arial",labelfontsize=7,color="red"];
   node [fontname="Helvetica",fontsize=10,shape=record,style=filled,fillcolor="white",color="red"];

   graph [ rankdir=BT ]
   node [ shape=none ]

    "MedicalRecord" [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td><b>\N</b></td></tr>
            <tr><td align="left">  recordType : String <br align="left"/></td></tr>
            <tr><td align="left"></td></tr>
        </table>> ];
    "PatientRecord" [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td><b>\N</b></td></tr>
            <tr><td align="left">  patientID : Integer <br align="left"/></td></tr>
            <tr><td align="left"></td></tr>
        </table>> ];
    "DoctorRecord" [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td><b>\N</b></td></tr>
            <tr><td align="left">  consultationFee : Real <br align="left"/></td></tr>
            <tr><td align="left">  processRecord(): OclVoid <br align="left"/></td></tr>
        </table>> ];
    "TreatmentRecord" [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td><b>\N</b></td></tr>
            <tr><td align="left">  treatmentCode : Integer <br align="left"/></td></tr>
            <tr><td align="left"></td></tr>
        </table>> ];

    "PatientRecord" -> "MedicalRecord" [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
    "DoctorRecord" -> "PatientRecord" [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
    "TreatmentRecord" -> "PatientRecord" [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
}
